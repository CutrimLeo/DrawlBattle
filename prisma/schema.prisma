generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model User {
 id String @id
 name String
 avatar String
 totalScore Int @default(0)
 correctGuesses Int @default(0)
 matchesPlayed Int @default(0)
 wins Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 results MatchResult[]
}
model Match {
 id String @id
 roomCode String
 startedAt DateTime
 finishedAt DateTime
 durationMs Int
 totalTurns Int
 completedTurns Int
 settingsJson String
 results MatchResult[]
}
model MatchResult {
 id String @id
 matchId String
 playerId String
 score Int
 correctGuesses Int
 rank Int
 match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
 player User @relation(fields: [playerId], references: [id], onDelete: Cascade)
 @@unique([matchId, playerId])
}
model Word {
 id String @id
 text String @unique
 category String
 difficulty String
}
